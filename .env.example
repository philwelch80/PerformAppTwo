VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Defaults to "singleton" (the live row) if unset. Use a different value for
# dev/branch deploys so the live row is never touched.
#
# This must also be set in Netlify for the deploy-preview and branch-deploy
# contexts (Site configuration -> Environment variables -> scope to those
# contexts), not just for Production -- otherwise PR previews silently fall
# back to "singleton" and read/write the live plan.
VITE_STATE_ROW_ID=
